# =============================================================
# DairyMitr environment — copy to .env for LOCAL development only.
# In production set these in the hosting platform's settings.
# Never commit a real .env file.
# =============================================================

# --- Required ------------------------------------------------
# 32+ random characters. Generate:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-64-character-random-hex-string

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=dairymitr_app
MYSQL_PASSWORD=change-me
MYSQL_DB=dairymitr

# --- Environment ---------------------------------------------
# production (default) refuses to start without SECRET_KEY.
# development allows a random key and plain-HTTP cookies.
DAIRYMITR_ENV=production
# Set to 0 ONLY for local http:// development.
SESSION_COOKIE_SECURE=1
# Number of reverse proxies in front of the app (Render/Railway/Nginx: 1).
TRUST_PROXY_HOPS=1
# 1 = log CSP violations without blocking (for troubleshooting only).
CSP_REPORT_ONLY=0
LOG_TO_STDOUT=1
# FLASK_DEBUG=1   # local only; never in production

# --- Platform administrators (whole-database backup/restore) --
DAIRYMITR_ADMIN_EMAILS=admin@example.com

# --- Email (Brevo) / SMTP feedback ---------------------------
BREVO_API_KEY=
EMAIL_USER=
EMAIL_PASS=
OTP_EXPIRY_MINUTES=5

# --- SMS (Twilio, optional) ----------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=

# --- Web push (regenerate: python generate_vapid_keys.py) ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY_FILE=vapid_private_key.pem
VAPID_CLAIM_EMAIL=mailto:admin@example.com

# --- DairyMitr AI (Gemini, optional) -------------------------
GEMINI_API_KEY=
