# =============================================================
# DairyPro environment - copy to .env for LOCAL development only.
# In production (Railway) set these in the service's Variables tab.
# Never commit a real .env file. No real secret belongs in this file.
# =============================================================

# --- Required ------------------------------------------------
# 32+ random characters. Generate:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Changing it logs everybody out (use that to invalidate old sessions).
SECRET_KEY=change-me-to-a-64-character-random-hex-string

# MySQL (Railway MySQL plugin: copy MYSQLHOST / MYSQLPORT / MYSQLUSER /
# MYSQLPASSWORD / MYSQLDATABASE into these five variables)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=dairypro
MYSQL_CONNECT_TIMEOUT=10

# --- Environment ---------------------------------------------
# production (default) refuses to start without SECRET_KEY and never runs
# the debugger. development allows a random key and plain-HTTP cookies.
# (DAIRYMITR_ENV is still accepted for existing deployments.)
DAIRYPRO_ENV=production
# Set to 0 ONLY for local http:// development.
SESSION_COOKIE_SECURE=1
# Number of reverse proxies in front of the app (Railway/Render/Nginx: 1).
TRUST_PROXY_HOPS=1
# 1 = log CSP violations without blocking (troubleshooting only).
CSP_REPORT_ONLY=0
LOG_TO_STDOUT=1
# FLASK_DEBUG=1   # local only; never in production

# --- Platform administrators ---------------------------------
# Comma-separated owner e-mails allowed to use whole-database backup/restore
# and the /admin/subscriptions page. (DAIRYMITR_ADMIN_EMAILS also accepted.)
DAIRYPRO_ADMIN_EMAILS=admin@example.com

# --- Razorpay subscriptions ----------------------------------
# Test mode first: keys start with rzp_test_. Switch to rzp_live_ keys only
# after the test checklist in README.md passes.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Webhooks -> URL https://<your-domain>/razorpay/webhook,
# events: payment.captured, order.paid, payment.failed, refund.processed
RAZORPAY_WEBHOOK_SECRET=
# auto (default) = restrict expired accounts only when Razorpay keys are set;
# 1 = always enforce; 0 = never restrict (trial is still tracked).
DAIRYPRO_ENFORCE_SUBSCRIPTION=auto
# Free trial length in days (counted from the first successful login).
DAIRYPRO_TRIAL_DAYS=20

# --- Branding (optional) -------------------------------------
# Files under static/. Replace static/images/dairypro-logo.png and
# dairypro-icon.png with the official artwork, or point to other files.
# DAIRYPRO_LOGO=images/dairypro-logo.png
# DAIRYPRO_ICON=images/dairypro-icon.png

# --- Email (Brevo) / support ---------------------------------
BREVO_API_KEY=
# Must be a sender verified in Brevo.
EMAIL_SENDER_ADDRESS=dairymitra.official@gmail.com
SUPPORT_EMAIL=dairymitra.official@gmail.com
EMAIL_USER=
EMAIL_PASS=
OTP_EXPIRY_MINUTES=5

# --- SMS (Twilio, optional) ----------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=

# --- Web push (regenerate: python tools/generate_vapid_keys.py) ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY_FILE=vapid_private_key.pem
VAPID_CLAIM_EMAIL=mailto:admin@example.com

# --- Gunicorn (production server) ----------------------------
# Railway: about 2 x vCPUs of the service (load test: 2 vCPU -> 4).
# WEB_CONCURRENCY=4
# GUNICORN_THREADS=2
# GUNICORN_MAX_REQUESTS=10000
# GUNICORN_PRELOAD=1

# --- Notification delivery ----------------------------------
NOTIFY_THREADS=2
# Seconds before a push / SMS / email / Razorpay call is abandoned.
EXTERNAL_CALL_TIMEOUT=10
# NOTIFY_SYNC=1   # send inline (debugging only)

# --- DairyPro AI (Gemini, optional) -------------------------
GEMINI_API_KEY=

# --- Translations (optional) --------------------------------
# 1 = log every UI string that has no translation (development only)
# DAIRYPRO_I18N_DEBUG=0
